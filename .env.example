# ── Django core ──────────────────────────────────────────────────────────────
# Generate a new value with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ── Database (MySQL) ─────────────────────────────────────────────────────────
# Create the DB first:
#   CREATE DATABASE vayu_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql://root:yourpassword@127.0.0.1:3306/vayu_db

# ── Simulator / service-account user ─────────────────────────────────────────
# Password for the non-admin 'simulator' user used by the Phase 3 sensor
# simulator script.  After running `python manage.py migrate`, create this user
# and obtain its API token by running the snippet in README.md § Token Auth.
SIMULATOR_PASSWORD=choose-a-strong-password-here
# Token printed by the shell snippet in README.md § Running the Sensor Simulator.
# Run the snippet once after migrate to generate this value.
SIMULATOR_TOKEN=

# ── External AQI ──────────────────────────────────────────────────────────────
# World Air Quality Index (WAQI) API token.
# Register for a FREE token at: https://aqicn.org/data-platform/token/
# If left empty, location search will only return results for VAYU's own sensors.
WAQI_API_TOKEN=

# ── Cache (optional overrides) ──────────────────────────────────────────────────
# Default: in-process LocMemCache (fine for dev, lost on restart).
# For production use Redis:
#   CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
#   CACHE_LOCATION=redis://127.0.0.1:6379/1
CACHE_BACKEND=
CACHE_LOCATION=
