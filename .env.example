# ── Django core ──────────────────────────────────────────────────────────────
# Generate a new value with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ── Database (Optional, defaults to SQLite if omitted) ───────────────────────
# Defaults to sqlite:///db.sqlite3 if omitted.
# To use MySQL (create database vayu_db first):
# DATABASE_URL=mysql://root:yourpassword@127.0.0.1:3306/vayu_db

# ── Simulator / service-account user ─────────────────────────────────────────
# (Optional) Custom password for the scoped 'simulator' service account.
# Run `python manage.py bootstrap_demo` to automatically provision this account,
# pre-create demo sensors, and print its API token.
SIMULATOR_PASSWORD=choose-a-strong-password-here
# Token printed by `python manage.py bootstrap_demo`.
# Add this value to your .env or export it as SIMULATOR_TOKEN.
SIMULATOR_TOKEN=

# ── External AQI ──────────────────────────────────────────────────────────────
# World Air Quality Index (WAQI) API token.
# Register for a FREE token at: https://aqicn.org/data-platform/token/
# If left empty, location search will only return results for VAYU's own sensors.
WAQI_API_TOKEN=

# ── Cache (optional overrides) ──────────────────────────────────────────────────
# Default: in-process LocMemCache (fine for dev, lost on restart).
# For production use Redis:
#   CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
#   CACHE_LOCATION=redis://127.0.0.1:6379/1
CACHE_BACKEND=
CACHE_LOCATION=
